#!/usr/bin/env python3
"""Authorize one exact landing transaction; preserve ref-only maintenance."""

import fcntl
from datetime import UTC, datetime
import json
import os
from pathlib import Path
import subprocess
import sys
import tomllib


def git(*args):
    return subprocess.check_output(["git", *args], stderr=subprocess.DEVNULL).decode().strip()


def command(pid):
    return [part.decode() for part in Path(f"/proc/{pid}/cmdline").read_bytes().split(b"\0") if part]


def parent(pid):
    # The comm field may contain spaces and parentheses.
    return int(Path(f"/proc/{pid}/stat").read_text().rsplit(")", 1)[1].split()[1])


def maintenance(old, new, current, common):
    if new == current and new.strip("0"):
        return True
    args = command(os.getppid())
    if new.strip("0") or not old.strip("0") or old != current:
        return False
    if not args or Path(args[0]).name != "git":
        return False
    index = 1
    while index < len(args) and args[index] in ("-C", "-c"):
        index += 2
    if index >= len(args) or args[index] != "pack-refs":
        return False
    return f"{old} refs/heads/main" in (common / "packed-refs").read_text().splitlines()


def authorize(common, old, new):
    grant_path = common / "x-land-grant.json"
    grant = json.loads(grant_path.read_text())
    if (old, new) != (grant["old"], grant["new"]) or not new.strip("0"):
        return False
    pid = grant["pid"]
    if not isinstance(pid, int) or pid <= 0:
        return False
    os.kill(pid, 0)
    args = command(pid)
    if len(args) != 3 or Path(args[1]).name != "x" or args[2] != "land":
        return False
    runner = Path(args[1])
    if not runner.is_absolute():
        runner = Path(f"/proc/{pid}/cwd").resolve() / runner
    repo = runner.resolve().parent
    runner_common = subprocess.check_output(
        ["git", "-C", str(repo), "rev-parse", "--git-common-dir"]
    ).decode().strip()
    if (repo / runner_common).resolve() != common:
        return False
    ancestor = os.getppid()
    while ancestor != pid and ancestor > 1:
        ancestor = parent(ancestor)
    if ancestor != pid:
        return False
    settings = tomllib.loads((repo / "Tools/x/settings.toml").read_text())
    lock = Path(settings["lock_dir"]).expanduser() / "land.lock"
    with lock.open("rb") as stream:
        try:
            fcntl.flock(stream, fcntl.LOCK_EX | fcntl.LOCK_NB)
        except BlockingIOError:
            pass
        else:
            return False
    holders = [json.loads(path.read_text()) for path in lock.parent.glob(f"land.lock.{pid}.*.holder.json")]
    if not any(
        holder["pid"] == pid and holder["command"] == "land"
        and holder["run_id"] == grant["run_id"] and holder["worktree"] == str(repo)
        for holder in holders
    ):
        return False
    # Keep transaction-bound evidence for committed/aborted, not a reusable grant.
    pending = common / "x-land-grant.json.prepared"
    if pending.exists():
        previous = json.loads(pending.read_text())
        previous_pid = previous["transaction_pid"]
        if not isinstance(previous_pid, int) or previous_pid <= 0:
            raise ValueError("invalid prepared transaction pid")
        try:
            os.kill(previous_pid, 0)
        except ProcessLookupError:
            pending.unlink()
        else:
            state = Path(f"/proc/{previous_pid}/stat").read_text().rsplit(")", 1)[1].split()[0]
            if state == "Z":
                pending.unlink()
    with pending.open("x") as stream:
        json.dump({**grant, "transaction_pid": os.getppid()}, stream)
        stream.flush()
        os.fsync(stream.fileno())
    grant_path.unlink()
    return True


def finish(common, updates, committed):
    pending = common / "x-land-grant.json.prepared"
    if not pending.exists():
        return
    grant = json.loads(pending.read_text())
    if grant["transaction_pid"] != os.getppid():
        return
    if (grant["old"], grant["new"], "refs/heads/main") not in updates:
        return
    if committed:
        ledger = common / "x-land-ledger.jsonl"
        entries = [json.loads(line) for line in ledger.read_text().splitlines()]
        endpoint = entries[-1].get("new", entries[-1].get("seed"))
        anchor_ref = "refs/x/land-ledger"
        anchor_oid = git("rev-parse", "--verify", anchor_ref)
        anchor = json.loads(git("cat-file", "blob", anchor_oid))
        if anchor != {"entries": len(entries), "new": endpoint}:
            raise ValueError("ledger disagrees with its anchor before commit")
        if endpoint != grant["old"] or git("rev-parse", "refs/heads/main") != grant["new"]:
            raise ValueError("main transaction differs from the landing ledger")
        entry = {
            "old": grant["old"], "new": grant["new"], "run_id": grant["run_id"],
            "time": datetime.now(UTC).isoformat(),
        }
        with ledger.open("a") as stream:
            stream.write(json.dumps(entry) + "\n")
            stream.flush()
            os.fsync(stream.fileno())
        data = json.dumps({"entries": len(entries) + 1, "new": grant["new"]}).encode()
        oid = subprocess.check_output(["git", "hash-object", "-w", "--stdin"], input=data).decode().strip()
        git("update-ref", anchor_ref, oid, anchor_oid)
    pending.unlink()


def main():
    phase = sys.argv[1]
    if phase not in {"prepared", "committed", "aborted"}:
        return 0
    common = Path(git("rev-parse", "--git-common-dir")).resolve()
    updates = [tuple(line.split()) for line in sys.stdin]
    if phase != "prepared":
        try:
            finish(common, updates, phase == "committed")
        except (OSError, ValueError, KeyError, TypeError, subprocess.CalledProcessError) as error:
            print(f"main audit failed: {error}; stop and ask the owner", file=sys.stderr)
            return 1
        return 0
    for old, new, ref in updates:
        if ref != "refs/heads/main":
            continue
        try:
            current = git("rev-parse", "--verify", ref)
        except subprocess.CalledProcessError:
            current = ""
        try:
            if maintenance(old, new, current, common):
                continue
            if (
                not current and new.strip("0") and not (common / "x-land-ledger.jsonl").exists()
                and subprocess.run(["git", "rev-parse", "--verify", "--quiet", "refs/x/land-ledger"],
                                   stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL).returncode == 1
            ):
                continue
            if authorize(common, old, new):
                continue
        except (OSError, ValueError, KeyError, TypeError, subprocess.CalledProcessError):
            pass
        print("main only moves through ./x land; stop and ask the owner", file=sys.stderr)
        return 1
    return 0


sys.exit(main())
